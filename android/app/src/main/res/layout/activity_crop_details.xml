<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/cropDetailsToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Crop Profile"
            app:titleTextColor="@color/primary"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/primary"
            style="@style/Widget.MaterialComponents.Toolbar.Surface" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/outline_variant" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Crop Header Profile Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_container_lowest">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCropDetailName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Crop Name"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_surface" />

                            <TextView
                                android:id="@+id/tvCropDetailScientific"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Scientific Taxonomy"
                                android:textSize="13sp"
                                android:textStyle="italic"
                                android:textColor="@color/on_surface_variant" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCropDetailStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:background="@drawable/bg_badge_success"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCropDetailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Agronomic description and growth conditions."
                        android:textSize="13sp"
                        android:textColor="@color/on_surface"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/cropDetailProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminateTint="@color/primary" />

            <!-- Associated Pests Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASSOCIATED PEST THREATS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/outline"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvAssociatedPests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Loading associated pests..."
                android:textSize="13sp"
                android:textColor="@color/on_surface"
                android:lineSpacingExtra="3dp" />

            <!-- Associated Diseases Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASSOCIATED PLANT DISEASES"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/amber_600"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvAssociatedDiseases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Loading associated diseases..."
                android:textSize="13sp"
                android:textColor="@color/on_surface"
                android:lineSpacingExtra="3dp" />

            <!-- New Scan Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetectForThisCrop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="Scan This Crop For Pests &amp; Diseases"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary"
                app:backgroundTint="@color/primary"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

