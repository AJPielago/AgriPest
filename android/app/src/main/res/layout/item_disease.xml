<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDiseaseItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_variant"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/surface_container_lowest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDiseaseTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disease Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/tvDiseasePathogenBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fungal"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/amber_600"
                android:background="@drawable/bg_badge_warning"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDiseaseScientific"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Scientific Name"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="@color/on_surface_variant" />

        <TextView
            android:id="@+id/tvDiseaseSymptoms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Symptoms description"
            android:textSize="12sp"
            android:textColor="@color/on_surface"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tvDiseaseDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="General Pathology notes"
            android:textSize="11sp"
            android:textColor="@color/on_surface_variant"
            android:lineSpacingExtra="2dp" />

        <View
            android:id="@+id/dividerRecs"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@color/surface_variant" />

        <TextView
            android:id="@+id/tvDiseaseRecommendationsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MANAGEMENT &amp; TREATMENT"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/outline"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvDiseaseRecommendationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Recommendations details"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

