<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/surface">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/detectToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:title="@string/title_detect"
            app:titleTextColor="@color/primary"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/primary"
            style="@style/Widget.MaterialComponents.Toolbar.Surface">

            <ImageView
                android:id="@+id/btnNavNotifications"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_notifications"
                app:tint="@color/on_surface_variant" />
        </com.google.android.material.appbar.MaterialToolbar>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/outline_variant" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Title & Subtitle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_detect"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/detect_subtitle"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>

                <!-- Specimen Framing & Input Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface_container_lowest">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/specimen_capture_frame"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/outline"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="12dp" />

                        <!-- Framing Preview Box -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:background="@drawable/bg_card_stitch">

                            <ImageView
                                android:id="@+id/ivSpecimenPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="Crop Specimen Preview" />

                            <LinearLayout
                                android:id="@+id/layoutUploadPlaceholder"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:gravity="center">

                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_badge_neutral">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_camera"
                                        app:tint="@color/primary" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/align_crop_in_frame"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/take_photo_or_select"
                                    android:textColor="@color/outline"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Camera & Gallery Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCamera"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:text="@string/camera"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:icon="@drawable/ic_camera"
                                app:iconGravity="textStart"
                                app:cornerRadius="8dp"
                                app:backgroundTint="@color/primary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGallery"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:text="@string/gallery"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:textColor="@color/on_surface"
                                app:strokeColor="@color/outline_variant"
                                app:icon="@drawable/ic_photo"
                                app:iconGravity="textStart"
                                app:iconTint="@color/on_surface"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Telemetry & Diagnostic Parameters Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface_container_lowest">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/diagnostic_metadata"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/outline"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="12dp" />

                        <!-- Target Host Crop -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/target_host_crop"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface" />

                        <Spinner
                            android:id="@+id/spinnerCrops"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_card_stitch"
                            android:paddingHorizontal="12dp" />

                        <!-- Weather Condition -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weather_condition"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface" />

                        <Spinner
                            android:id="@+id/spinnerWeather"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_card_stitch"
                            android:paddingHorizontal="12dp" />

                        <!-- Field Location -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/field_sector_location"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/on_surface" />

                        <EditText
                            android:id="@+id/etFieldLocation"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_card_stitch"
                            android:paddingHorizontal="12dp"
                            android:hint="@string/field_location_hint"
                            android:textColor="@color/on_surface"
                            android:textColorHint="@color/outline"
                            android:textSize="13sp"
                            android:inputType="text" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Loading Progress Indicator -->
                <ProgressBar
                    android:id="@+id/detectProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />

                <!-- Submit Analyze Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitDetection"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/analyze_specimen"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_bug_report"
                    app:iconGravity="textStart"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/primary" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_drawer_header"
        app:menu="@menu/nav_menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
