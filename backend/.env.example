# Core Settings
PROJECT_NAME="AI-Based Pest Detection System"
API_V1_STR="/api/v1"
SECRET_KEY="your-secure-random-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database (Default: SQLite for dev, replace with PostgreSQL in production)
DATABASE_URL="sqlite:///./pest_detection.db"

# Pluggable Detection Engine Mode: 'mock' or 'ai'
DETECTION_MODE="mock"

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
